// Tang Nano 9K pins. LEDs are active-low.
IO_LOC "clk"    52;
IO_PORT "clk"   IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18; IO_PORT "led[1]" IO_TYPE=LVCMOS18; IO_PORT "led[2]" IO_TYPE=LVCMOS18;
IO_PORT "led[3]" IO_TYPE=LVCMOS18; IO_PORT "led[4]" IO_TYPE=LVCMOS18; IO_PORT "led[5]" IO_TYPE=LVCMOS18;
IO_LOC "uart_tx" 17;  // FPGA -> BL702 -> PC
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 18;  // PC -> BL702 -> FPGA
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "btn_s1" 4;   // S1 (S2 = pin 3); active-low
IO_PORT "btn_s1" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// HDMI (DVI) TMDS pairs. UNVERIFIED against the board schematic.
// P and N pins are listed separately; both nets come from TLVDS_OBUF (O and OB).
IO_LOC "tmds_clk_p"    69;
IO_LOC "tmds_clk_n"    68;
IO_LOC "tmds_d_p[0]"   71;   // channel 0 (blue, carries hsync/vsync)
IO_LOC "tmds_d_n[0]"   70;
IO_LOC "tmds_d_p[1]"   73;   // channel 1 (green)
IO_LOC "tmds_d_n[1]"   72;
IO_LOC "tmds_d_p[2]"   75;   // channel 2 (red)
IO_LOC "tmds_d_n[2]"   74;
IO_PORT "tmds_clk_p"  PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_clk_n"  PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
