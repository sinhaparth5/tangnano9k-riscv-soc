// Tang Nano 9K pins. LEDs are active-low.
IO_LOC "clk"    52;
IO_PORT "clk"   IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18; IO_PORT "led[1]" IO_TYPE=LVCMOS18; IO_PORT "led[2]" IO_TYPE=LVCMOS18;
IO_PORT "led[3]" IO_TYPE=LVCMOS18; IO_PORT "led[4]" IO_TYPE=LVCMOS18; IO_PORT "led[5]" IO_TYPE=LVCMOS18;
IO_LOC "uart_tx" 17;  // FPGA -> BL702 -> PC
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 18;  // PC -> BL702 -> FPGA
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "btn_s1" 4;   // S1 (S2 = pin 3); active-low
IO_PORT "btn_s1" IO_TYPE=LVCMOS18 PULL_MODE=UP;
